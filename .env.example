# ── Database ───────────────────────────────────────────────
# Local example: postgres://USER:PASSWORD@localhost:5432/rewardsdesk
# Railway injects DATABASE_URL automatically when a Postgres plugin is attached.
DATABASE_URL=postgres://localhost:5432/rewardsdesk

# Force TLS for the DB connection. Leave unset for local dev and Railway's
# internal network; set to "true" for most external managed Postgres.
# Certificates are verified by default; PGSSL_NO_VERIFY=true opts out for
# providers with self-signed chains.
# PGSSL=true
# PGSSL_NO_VERIFY=true

# ── Auth ───────────────────────────────────────────────────
# REQUIRED. Long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# ── Initial admin (consumed by `npm run seed`) ─────────────
# In production the seed refuses known-default/short passwords (<10 chars).
ADMIN_NAME=Hotel Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# ── Payments (Stripe — guest parking) ──────────────────────
# Secret key (sk_test_... in test mode, sk_live_... in production).
# The app boots without it; parking payment endpoints return 503 until set.
STRIPE_SECRET_KEY=
# Webhook signing secret for the endpoint /api/parking/webhook.
# Local dev: from `stripe listen`. Production: from the Stripe dashboard's
# live webhook endpoint (a DIFFERENT whsec_ value than the CLI one).
STRIPE_WEBHOOK_SECRET=
# Absolute origin used to build Stripe success/cancel URLs
# (e.g. https://your-domain.com). Falls back to CLIENT_ORIGIN in dev.
PUBLIC_BASE_URL=

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Dev only: the Vite origin allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173

# Prod only: domain for the auth cookie (e.g. rewardsdesk.up.railway.app).
# COOKIE_DOMAIN=
